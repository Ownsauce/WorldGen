    <BaseIntermediateOutputPath>../tmp/dotnet-build/WorldGen.Core/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>../tmp/dotnet-build/WorldGen.Core/obj/</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
